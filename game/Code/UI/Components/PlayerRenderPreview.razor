@namespace Dxura.RP.Game.UI
@using Dxura.RP.Shared
@using Sandbox
@using Sandbox.UI
@using global::System.Threading.Tasks
@inherits Panel

@attribute [StyleSheet]

@if ( !IsSubjectValid )
{
	return;
}

<root class="player-render-preview @(_isDragging ? "dragging" : string.Empty)">
	<div class="preview-shell">
		<ScenePanel @ref="_scenePanel" class="preview-scene"/>
	</div>
</root>

@code
{
	private static readonly Vector3 PreviewOrigin = new( 0f, 0f, -9100f );

	private ScenePanel? _scenePanel;
	private Scene? _scene;
	private GameObject? _cameraObject;
	private CameraComponent? _camera;
	private GameObject? _pivot;
	private GameObject? _body;
	private GameObject? _light;
	private string? _signature;
	private Vector3 _focusPoint = new Vector3( 0f, 0f, -9100f ) + Vector3.Up * 12f;
	private Vector3 _modelSize = new( 32f, 32f, 72f );
	private float _fitDistance = 80f;
	private float _zoomOffset;
	private float _minDistance = 52f;
	private float _maxDistance = 128f;
	private float _yaw = -10f;
	private float _yawVelocity;
	private bool _isDragging;
	private Vector2 _lastMousePosition;
	private int _previewVersion;

	public GameModeJobDto? Job { get; set; }
	public Player? Player { get; set; }

	private bool IsSubjectValid =>
		( Job != null && Job.IsValid() ) || ( Player != null && Player.IsValid() );

	private float FieldOfView => Player != null ? 25f : 40f;
	private float CameraPitchDegrees => Player != null ? 0f : 12f;
	private float LookTargetRaise => Player != null ? 0f : -7f;
	private float VerticalCoverage => Player != null ? 1.08f : 0.78f;
	private float HorizontalCoverage => Player != null ? 0.98f : 0.62f;
	private bool AdjustForPanelSize => Player == null;

	public override void Tick()
	{
		base.Tick();

		if ( !IsSubjectValid )
		{
			ClearPreview();
			return;
		}

		if ( _scenePanel == null )
		{
			return;
		}

		EnsureScene();

		var sig = BuildSignature();
		if ( sig != _signature )
		{
			RebuildPreview();
			_signature = sig;
		}

		if ( !_isDragging && _pivot.IsValid() && MathF.Abs( _yawVelocity ) > 0.01f )
		{
			_yaw += _yawVelocity * Time.Delta;
			_pivot.WorldRotation = Rotation.From( 0f, _yaw, 0f );
			_yawVelocity *= MathF.Pow( 0.12f, Time.Delta );

			if ( MathF.Abs( _yawVelocity ) < 2f )
			{
				_yawVelocity = 0f;
			}
		}

		UpdateScenePanel();
	}

	protected override void OnMouseDown( MousePanelEvent e )
	{
		base.OnMouseDown( e );
		_isDragging = true;
		_yawVelocity = 0f;
		_lastMousePosition = e.LocalPosition;
		e.StopPropagation();
	}

	protected override void OnMouseUp( MousePanelEvent e )
	{
		base.OnMouseUp( e );
		_isDragging = false;
		e.StopPropagation();
	}

	protected override void OnMouseMove( MousePanelEvent e )
	{
		base.OnMouseMove( e );

		if ( !_isDragging || !_pivot.IsValid() )
		{
			return;
		}

		var delta = e.LocalPosition - _lastMousePosition;
		_lastMousePosition = e.LocalPosition;

		if ( delta.LengthSquared < 0.01f )
		{
			return;
		}

		var yawDelta = delta.x * 0.35f;
		_yaw += yawDelta;
		_yawVelocity = yawDelta / MathF.Max( Time.Delta, 0.001f );
		_pivot.WorldRotation = Rotation.From( 0f, _yaw, 0f );
		e.StopPropagation();
	}

	public override void OnMouseWheel( Vector2 value )
	{
		base.OnMouseWheel( value );
		var distance = Math.Clamp( _fitDistance + _zoomOffset - value.y * 4f, _minDistance, _maxDistance );
		_zoomOffset = distance - _fitDistance;
	}

	public override void OnDeleted()
	{
		base.OnDeleted();
		ClearPreview();
	}

	private string BuildSignature()
	{
		if ( Player != null )
		{
			var avatarData = Player.Network.Owner?.GetUserData( "avatar" ) ?? string.Empty;
			var modelHash = Player.Renderer.IsValid() && Player.Renderer.Model.IsValid()
				? Player.Renderer.Model.GetHashCode()
				: 0;
			return $"{Player.SteamId}:{Player.Job.Id}:{modelHash}:{avatarData}";
		}

		var jobAvatarData = Player.Local.IsValid()
			? Player.Local.Network.Owner?.GetUserData( "avatar" ) ?? string.Empty
			: string.Empty;
		return $"{Job!.Id}:{Job.Model}:{string.Join( ',', Job.Clothes )}:{jobAvatarData}";
	}

	private void PopulatePreview( SkinnedModelRenderer renderer )
	{
		if ( Player != null )
		{
			renderer.Model = Player.GetPrimaryModel();
			if ( Player.Job.SupportsCitizenClothing() )
			{
				Player.Job.BuildClothing( Player ).Apply( renderer );
			}
			return;
		}

		var job = Job!;

		if ( job.HasCloudModel() )
		{
			renderer.Enabled = false;
			_ = ApplyCloudModelAsync( job, renderer );
			return;
		}

		renderer.Model = job.GetPrimaryModel();
		if ( job.SupportsCitizenClothing() )
		{
			job.BuildClothing().Apply( renderer );
		}
	}

	private void CenterPreview( SkinnedModelRenderer renderer )
	{
		if ( !_body.IsValid() || !_pivot.IsValid() )
		{
			return;
		}

		var useModelBounds = renderer.Model.IsValid() && renderer.Model.Bounds.Size.LengthSquared > 1f;
		var bounds = useModelBounds ? renderer.Model.Bounds : renderer.Bounds;
		var worldBounds = !useModelBounds;
		CenterPreview( bounds, worldBounds );
	}

	private void CenterPreview( BBox bounds, bool worldBounds )
	{
		var localCenter = worldBounds ? bounds.Center - PreviewOrigin : bounds.Center;
		var localMins = worldBounds ? bounds.Mins - PreviewOrigin : bounds.Mins;
		var rawWidth = MathF.Max( MathF.Max( bounds.Size.x, bounds.Size.y ), 18f );
		var rawHeight = MathF.Max( bounds.Size.z, 48f );

		if ( Player != null )
		{
			var width = MathF.Min( rawWidth, 58f );
			var height = MathF.Min( rawHeight, 84f );

			_modelSize = new Vector3( width, width, height );
			_body!.LocalPosition = new Vector3( -localCenter.x, -localCenter.y, -localMins.z );
			_focusPoint = PreviewOrigin + Vector3.Up * Math.Clamp( height * 0.58f, 22f, height * 0.72f );
			_fitDistance = Math.Clamp( MathF.Max( height * 0.68f, width * 1.28f ), 44f, 96f );
			_zoomOffset = 0f;
			_minDistance = Math.Clamp( _fitDistance * 0.72f, 36f, 84f );
			_maxDistance = Math.Clamp( _fitDistance * 1.45f, 60f, 144f );
		}
		else
		{
			var width = MathF.Min( rawWidth, 46f );
			var height = MathF.Min( rawHeight, 76f );

			_modelSize = new Vector3( width, width, height );
			_body!.LocalPosition = new Vector3( -localCenter.x, -localCenter.y, -localMins.z + 5f );
			_focusPoint = PreviewOrigin + Vector3.Up * Math.Clamp( height * 0.85f, 56f, 78f );
			_fitDistance = Math.Clamp( MathF.Max( height * 0.45f, width * 0.9f ), 30f, 60f );
			_zoomOffset = 0f;
			_minDistance = Math.Clamp( _fitDistance * 0.7f, 22f, 40f );
			_maxDistance = Math.Clamp( _fitDistance * 1.4f, 30f, 52f );
		}
	}

	private void UpdateScenePanel()
	{
		if ( _scenePanel == null || _scene == null || !_scene.IsValid() || !_camera.IsValid() )
		{
			return;
		}

		if ( _scenePanel.Box.Rect.Width < 10 || _scenePanel.Box.Rect.Height < 10 )
		{
			return;
		}

		var aspectRatio = _scenePanel.Box.Rect.Height > 0f
			? _scenePanel.Box.Rect.Width / _scenePanel.Box.Rect.Height
			: 1f;

		var distance = Math.Clamp( CalculateFitDistance( aspectRatio ) + _zoomOffset, _minDistance, _maxDistance );
		var pitch = CameraPitchDegrees * MathF.PI / 180f;
		var cameraOffset = new Vector3( distance * MathF.Cos( pitch ), -2f, distance * MathF.Sin( pitch ) );
		var cameraPosition = _focusPoint + cameraOffset;
		var lookTarget = _focusPoint + Vector3.Up * LookTargetRaise;

		_camera.WorldPosition = cameraPosition;
		_camera.WorldRotation = Rotation.LookAt( lookTarget - cameraPosition, Vector3.Up );
		_camera.FieldOfView = FieldOfView;
		_camera.BackgroundColor = Color.Transparent;
		_camera.ZNear = 1f;
		_camera.ZFar = 256f;

		if ( _light.IsValid() )
		{
			_light.WorldPosition = _focusPoint + Vector3.Forward * 80f + Vector3.Left * 30f + Vector3.Up * 90f;
			_light.WorldRotation = Rotation.LookAt( _focusPoint - _light.WorldPosition, Vector3.Up );
		}
	}

	private float CalculateFitDistance( float aspectRatio )
	{
		aspectRatio = MathF.Max( aspectRatio, 0.75f );

		var halfVerticalFov = MathF.Tan( FieldOfView * 0.5f * MathF.PI / 180f );
		var halfHorizontalFov = halfVerticalFov * aspectRatio;
		var heightDistance = _modelSize.z / ( 2f * halfVerticalFov * VerticalCoverage );
		var widthDistance = _modelSize.x / ( 2f * halfHorizontalFov * HorizontalCoverage );
		var distance = MathF.Max( _fitDistance, MathF.Max( heightDistance, widthDistance ) );

		if ( AdjustForPanelSize && _scenePanel != null )
		{
			var panelHeight = _scenePanel.Box.Rect.Height;
			if ( panelHeight > 0f && panelHeight < 400f )
			{
				var t = panelHeight / 400f;
				distance *= 1.58f + ( 1f - 1.58f ) * t;
			}
		}

		return distance;
	}

	private void RebuildPreview()
	{
		var previewVersion = ++_previewVersion;
		DestroyPreviewObjects();
		EnsureScene();
		if ( _scene == null || !_scene.IsValid() )
		{
			return;
		}

		using ( _scene.Push() )
		{
			_yaw = -10f;
			_yawVelocity = 0f;
			_pivot = new GameObject( true, "preview_pivot" )
			{
				WorldPosition = PreviewOrigin,
				WorldRotation = Rotation.From( 0f, _yaw, 0f )
			};

			_body = new GameObject( true, "preview_display" ) { Parent = _pivot };

			var renderer = _body.AddComponent<SkinnedModelRenderer>();
			PopulatePreview( renderer );
			EnsureLight();
			if ( renderer.Model.IsValid() ) CenterPreview( renderer );
			_ = CenterPreviewAsync( renderer, previewVersion );
		}
	}

	private async Task CenterPreviewAsync( SkinnedModelRenderer renderer, int previewVersion )
	{
		await Task.FixedUpdate();

		if ( previewVersion != _previewVersion || !renderer.IsValid() || _scene == null || !_scene.IsValid() )
		{
			return;
		}

		using ( _scene.Push() )
		{
			CenterPreview( renderer );
		}
	}

	private void EnsureLight()
	{
		if ( _light.IsValid() )
		{
			return;
		}

		_light = new GameObject( true, "preview_light" );
		var spotLight = _light.AddComponent<SpotLight>();
		spotLight.LightColor = Color.White * 2.2f;
		spotLight.Radius = 320f;
		spotLight.Attenuation = 0.55f;
		spotLight.ConeOuter = 70f;
		spotLight.Shadows = false;
	}

	private void EnsureScene()
	{
		if ( _scenePanel == null )
		{
			return;
		}

		_scene = _scenePanel.RenderScene;
		if ( _cameraObject.IsValid() && _camera.IsValid() )
		{
			return;
		}

		if ( _scene == null || !_scene.IsValid() )
		{
			return;
		}

		using ( _scene.Push() )
		{
			_cameraObject = new GameObject( true, "preview_camera" );
			_camera = _cameraObject.AddComponent<CameraComponent>();
			_camera.IsMainCamera = true;
			_camera.BackgroundColor = Color.Transparent;
			_camera.ZNear = 1f;
			_camera.ZFar = 256f;
			_camera.FieldOfView = FieldOfView;
		}
	}

	private void ClearPreview()
	{
		_isDragging = false;
		_signature = null;
		DestroyPreviewObjects();
	}

	private void DestroyPreviewObjects()
	{
		if ( _body.IsValid() ) _body.DestroyImmediate();
		_body = null;

		if ( _pivot.IsValid() ) _pivot.DestroyImmediate();
		_pivot = null;

		if ( _cameraObject.IsValid() ) _cameraObject.DestroyImmediate();
		_cameraObject = null;
		_camera = null;

		if ( _light.IsValid() ) _light.DestroyImmediate();
		_light = null;
	}

	private async Task ApplyCloudModelAsync( GameModeJobDto job, SkinnedModelRenderer renderer )
	{
		var model = await job.GetPrimaryModelAsync();
		if ( !renderer.IsValid() || _scene == null || !_scene.IsValid() )
		{
			return;
		}

		using ( _scene.Push() )
		{
			renderer.Model = model;
			renderer.Enabled = true;
			CenterPreview( renderer );
		}
	}
}
