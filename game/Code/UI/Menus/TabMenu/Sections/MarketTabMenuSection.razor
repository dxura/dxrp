@namespace Dxura.RP.Game.UI
@using Sandbox.Services
@inherits Panel

<root>
	<div class="market">
		<div class="section-header market-toolbar">
			<h1>@Language.GetPhrase( "tabmenu.market" )</h1>
			<div class="market-toolbar-actions">
				@if ( CanUseAdminMode )
				{
					<button class="lock-toggle @( _adminMode ? "active admin-active" : "" )"
					        onclick="@ToggleAdminMode">
						<i class="material-icons">admin_panel_settings</i>
						<span>@Language.GetPhrase( _adminMode ? "tabmenu.market.admin_mode.on" : "tabmenu.market.admin_mode.off" )</span>
					</button>
				}
				<button class="lock-toggle @( _showLocked ? "active" : "" )"
				        onclick="@( () => { _showLocked = !_showLocked; Sound.Play( "pop" ); } )">
					<i class="material-icons">@( _showLocked ? "visibility" : "visibility_off" )</i>
					<span>@Language.GetPhrase( _showLocked ? "tabmenu.market.hide_locked" : "tabmenu.market.show_locked" )</span>
				</button>
			</div>
		</div>

		<div class="market-scroll">
			@{
				var allItems = GameModeMarketItems.All
					.Select( item =>
					{
						var adminModeActive = _adminMode && CanUseAdminMode;
						var normallyPermitted = GameModeMarketItems.CanPurchase( Player.Local, item );
						var isPermitted = normallyPermitted || ( adminModeActive && GameModeMarketItems.CanAdminSpawn( Player.Local, item ) );
						var isStaffPurchase = adminModeActive && isPermitted;
						return (Item: item, Permitted: isPermitted, StaffPurchase: isStaffPurchase);
					} )
					.Where( x => _showLocked || x.Permitted )
					.GroupBy( x => { var g = GameModeMarketItems.Grouping( x.Item ); return string.IsNullOrEmpty( g ) ? "other" : g; } )
					.OrderBy( g => g.Key );
			}

			@foreach ( var group in allItems )
			{
				var isCollapsed = _collapsedCategories.Contains( group.Key );

				<div class="category @( isCollapsed ? "collapsed" : "" )">
					<div class="category-bar" onclick="@( () => ToggleCategory( group.Key ) )">
						<i class="material-icons category-toggle-icon">@( isCollapsed ? "chevron_right" : "expand_more" )</i>
						<span class="category-name">@GetCategoryText( group.Key )</span>
						<span class="category-count">@group.Count()</span>
					</div>

					@if ( !isCollapsed )
					{
						<div class="card-rail">
							@foreach ( var (item, isPermitted, isStaffPurchase) in group )
							{
								<div class="entity-card @( !isPermitted ? "is-locked" : "" )"
								     @onclick=@( () => HandleClick( item, isPermitted, isStaffPurchase ) )
								     tooltip="@( !string.IsNullOrEmpty( GameModeMarketItems.DisplayDescription( item ) ) ? GameModeMarketItems.DisplayDescription( item ) : null )">
									@{ var chipColor = GetItemColor( item ); }
									@if ( chipColor != Color.White )
									{
										<div class="card-chip" style="background-color: @chipColor.Hex"></div>
									}
									<div class="card-inner">
										@if ( !isPermitted )
										{
											<div class="card-lock">
												<i class="material-icons">lock</i>
											</div>
										}
										<div class="card-top">
											<span class="card-name">@GameModeMarketItems.DisplayName( item )</span>
											<span class="card-limit">@GetLimitText( item, isStaffPurchase )</span>
										</div>
										<div class="card-bottom">
											<span class="card-price">@GetPriceText( item, isStaffPurchase )</span>
										</div>
									</div>
									@if ( isStaffPurchase )
									{
										<div class="card-staff-border"></div>
									}
								</div>
							}
						</div>
					}
				</div>
			}

			@if ( !allItems.Any() )
			{
				<div class="market-empty">
					<i class="material-icons">storefront</i>
					<span>@Language.GetPhrase( "tabmenu.market.empty" )</span>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	private bool _showLocked;
	HashSet<string> _collapsedCategories = TabMenuSectionPreferences.LoadCollapsedMarketCategories();
	private bool _adminMode = TabMenuSectionPreferences.LoadMarketAdminMode() && CanUseAdminMode;

	private static bool CanUseAdminMode => RankSystem.HasLocalPermission( Permission.CommandSpawnEntity );

	protected override int BuildHash()
	{
		var ownedWorldCount = Player.Local.IsValid()
			? Scene.GetAllComponents<BaseEntity>().Count( entity => entity.IsValid() &&
				entity.EntityId != Guid.Empty &&
				entity.Owner == Player.Local.SteamId )
			: 0;
		var ownedEquipmentCount = Player.Local.IsValid()
			? Player.Local.Equipment.Count( equipment => equipment.IsValid() && equipment.Enabled && equipment.MarketItemId != Guid.Empty )
			: 0;
		var collapsedHash = 0;
		foreach ( var category in _collapsedCategories )
		{
			collapsedHash = HashCode.Combine( collapsedHash, category.GetHashCode() );
		}

		return HashCode.Combine( Player.Local.Job, _showLocked, _adminMode, ownedWorldCount, ownedEquipmentCount, collapsedHash );
	}

	private void ToggleCategory( string categoryKey )
	{
		Sound.Play( "pop" );

		if ( !_collapsedCategories.Add( categoryKey ) )
		{
			_collapsedCategories.Remove( categoryKey );
		}

		TabMenuSectionPreferences.SaveCollapsedMarketCategories( _collapsedCategories );
	}

	private void ToggleAdminMode()
	{
		_adminMode = !_adminMode;
		if ( _adminMode )
		{
			_showLocked = true;
		}

		TabMenuSectionPreferences.SaveMarketAdminMode( _adminMode );
		Sound.Play( "pop" );
	}
	private static string GetCategoryText( string? category )
	{
		if ( string.IsNullOrWhiteSpace( category ) ) return string.Empty;
		if ( category.StartsWith( '#' ) ) return Language.GetPhrase( category[1..] );
		return Language.GetPhrase( $"entity.category.{category.ToLowerInvariant()}" );
	}

	private string GetLimitText( GameModeMarketItemDto item, bool isStaffPurchase )
	{
		if ( isStaffPurchase )
		{
			return Language.GetPhrase( "tabmenu.market.admin_mode.unlimited" );
		}

		var limit = item.Type switch
		{
			GameModeMarketItemType.Equipment => GameModeMarketItems.ResolveEquipment( item )?.Limit ?? 0,
			GameModeMarketItemType.Entity => GameModeMarketItems.ResolveEntity( item )?.Limit ?? 0,
			_ => 0
		};
		if ( !Player.Local.IsValid() || limit <= 0 )
		{
			return Language.GetPhrase( "tabmenu.market.admin_mode.unlimited" );
		}

		var owned = GameModeMarketItems.GetOwnedCount( Player.Local, item );
		return $"{owned}/{limit}";
	}

	private string GetPriceText( GameModeMarketItemDto item, bool isStaffPurchase )
	{
		if ( isStaffPurchase )
		{
			return Language.GetPhrase( "tabmenu.market.admin_mode.free" );
		}

		var price = Math.Max( 0, (int)MathF.Ceiling( item.Cost * GameManager.Instance.EntityPriceMultiplier ) );
		return $"${price.ToString( "N0" )}";
	}

	private static Color GetItemColor( GameModeMarketItemDto item )
	{
		return item.Color.ToColor();
	}

	private void HandleClick( GameModeMarketItemDto item, bool isPermitted, bool isStaffPurchase )
	{
		if ( !isPermitted )
		{
			Notify.Error( "#generic.forbidden" );
			TabMenu.RequestCloseMenu();
			return;
		}

		if ( !isStaffPurchase )
		{
			switch ( GameModeMarketItems.Grouping( item ) )
			{
				case "printer":
					Achievements.Unlock( "illegal_print" );
					break;
				case "shipment":
					Achievements.Unlock( "self_supply" );
					break;
			}

			var basePrice = (uint)Math.Max( 0, (int)MathF.Ceiling( item.Cost * GameManager.Instance.EntityPriceMultiplier ) );
			if ( Config.Current.Game.MoneyEnabled && Player.Local.WalletBalance + Player.Local.BankBalance < basePrice )
			{
				Notify.Error( "#notify.cash.poor" );
				TabMenu.RequestCloseMenu();
				return;
			}
			if ( Cooldown.Current.CheckAndStartCooldown( Constants.EntityTag, Config.Current.Game.EntityCooldown, true ) )
			{
				return;
			}
		}

		if ( isStaffPurchase )
		{
			GameManager.Instance.SpawnMarketItemHost( item.Id );
		}
		else
		{
			GameManager.Instance.PurchaseMarketItemHost( item.Id );
		}

		TabMenu.RequestCloseMenu();
	}
}
